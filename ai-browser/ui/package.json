{
  "name": "ai-browser-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Side pane (AI assistant) of the AI-native browser: Preact + TypeScript, built to crates/shell/ui/sidebar and embedded in browser.exe",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
